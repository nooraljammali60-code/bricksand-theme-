{% if component.categories|length %}<section class="chocolate-section" data-testid="store-home-category-playground"><h2 class="chocolate-title">{{ component.title }}</h2><div class="category-playground">{% for category in component.categories %}<a href="{{ category.url }}">{% if category.image %}<img src="{{ category.image }}" alt="{{ category.name }}">{% endif %}<h3>{{ category.name }}</h3></a>{% endfor %}</div></section>{% endif %}