<section class="cinema">{% if component.video_url %}<video autoplay muted loop playsinline preload="metadata" {% if component.poster %}poster="{{ component.poster }}"{% endif %} aria-label="{{ store.name }}"><source src="{{ component.video_url }}" type="video/mp4"></video>{% elseif component.poster %}<img src="{{ component.poster }}" alt="{{ store.name }}" style="width:100%;height:100%;object-fit:cover">{% endif %}<div class="cinema-shade"></div><div class="cinema-copy">{% if component.eyebrow %}<span>{{ component.eyebrow }}</span>{% endif %}<h1>{{ component.title }}{% if component.title_em %} <em>{{ component.title_em }}</em>{% endif %}</h1></div></section>
