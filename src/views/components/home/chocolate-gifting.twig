{% if component.media %}<section class="chocolate-section editorial-grid" data-testid="store-home-gifting"><img src="{{ component.media }}" alt="{{ component.title }}"><div><h2 class="chocolate-title">{{ component.title }}</h2><p>{{ component.copy }}</p>{% if component.cta_url %}<a href="{{ component.cta_url }}">{{ component.cta_label }}</a>{% endif %}</div></section>{% endif %}