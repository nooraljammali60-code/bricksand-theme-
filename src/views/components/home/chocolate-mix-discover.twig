{% if component.products|length %}<section class="chocolate-section" data-testid="store-home-mix-discover"><h2 class="chocolate-title">{{ component.title }}</h2><p>{{ component.note }}</p><div class="product-strip">{% for product in component.products %}<a href="{{ product.url }}"><img src="{{ product.image.url }}" alt="{{ product.name }}"><h3>{{ product.name }}</h3></a>{% endfor %}</div></section>{% endif %}