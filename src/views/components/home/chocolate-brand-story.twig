{% if component.copy or component.media %}<section class="chocolate-section editorial-grid" data-testid="store-home-brand-story">{% if component.media %}<img src="{{ component.media }}" alt="{{ component.title }}">{% endif %}<div><h2 class="chocolate-title">{{ component.title }}</h2><p>{{ component.copy }}</p>{% if component.cta_url %}<a href="{{ component.cta_url }}">اكتشف الحكاية</a>{% endif %}</div></section>{% endif %}