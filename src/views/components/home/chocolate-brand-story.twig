<section id="story" class="chocolate-section editorial-grid" data-testid="store-home-brand-story">
  {% if component.media %}<img src="{{ component.media }}" alt="{{ component.title }}" loading="lazy">{% endif %}
  <div class="editorial-copy">
    <h2 class="chocolate-title">{{ component.title }}</h2>
    {% if component.copy %}<p>{{ component.copy }}</p>{% endif %}
    {% if component.cta_url %}<div><a class="chocolate-btn" href="{{ component.cta_url }}">اكتشف الحكاية</a></div>{% endif %}
  </div>
</section>
