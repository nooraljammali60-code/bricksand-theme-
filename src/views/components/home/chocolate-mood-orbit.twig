path d="M5 10v4a7.004 7.004 0 0 0 5.277 6.787c.412.104.802.292 1.102.592L12 22l.621-.621c.3-.3.69-.488 1.102-.592A7.003 7.003 0 0 0 19 14v-4"></path><path d="M12 4C8 4 4.5 6 4 8c-.243.97-.919 1.952-2 3 1.31-.082 1.972-.29 3-1 .54.92.982 1.356 2 2 1.452-.647 1.954-1.098 2.5-2 .595.995 1.151 1.427 2.5 2 1.31-.621 1.862-1.058 2.5-2 .629.977 1.162 1.423 2.5 2 1.209-.548 1.68-.967 2-2 1.032.916 1.683 1.157 3 1-1.297-1.036-1.758-2.03-2-3-.5-2-4-4-8-4Z"></path></svg>','<svg aria-hidden="true" class="lucide lucide-cake-slice" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M16 13H3"></path><path d="M16 17H3"></path><path d="m7.2 7.9-3.388 2.5A2 2 0 0 0 3 12.01V20a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-8.654c0-2-2.44-6.026-6.44-8.026a1 1 0 0 0-1.082.057L10.4 5.6"></path><circle cx="9" cy="7" r="2"></circle></svg>','<svg aria-hidden="true" class="lucide lucide-candy" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M10 7v10.9"></path><path d="M14 6.1V17"></path><path d="M16 7V3a1 1 0 0 1 1.707-.707 2.5 2.5 0 0 0 2.152.717 1 1 0 0 1 1.131 1.131 2.5 2.5 0 0 0 .717 2.152A1 1 0 0 1 21 8h-4"></path><path d="M16.536 7.465a5 5 0 0 0-7.072 0l-2 2a5 5 0 0 0 0 7.07 5 5 0 0 0 7.072 0l2-2a5 5 0 0 0 0-7.07"></path><path d="M8 17v4a1 1 0 0 1-1.707.707 2.5 2.5 0 0 0-2.152-.717 1 1 0 0 1-1.131-1.131 2.5 2.5 0 0 0-.717-2.152A1 1 0 0 1 3 16h4"></path></svg>','<svg aria-hidden="true" class="lucide lucide-gift" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M12 7v14"></path><path d="M20 11v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"></path><path d="M7.5 7a1 1 0 0 1 0-5A4.8 8 0 0 1 12 7a4.8 8 0 0 1 4.5-5 1 1 0 0 1 0 5"></path><rect height="4" rx="1" width="18" x="3" y="7"></rect></svg>'] %}{% set labels = (component.labels|default('شوكولاتة,كراميل,مقرمش,بيكان,كيك,غني,مشاركة'))|split(',') %}
{% set picked = component.products|default([]) %}<section class="mood-section is-visible" aria-labelledby="mood-title" data-mood-orbit{% if picked|length == 0 %} data-auto-wait{% endif %}><header class="section-heading">{% if component.eyebrow %}<span>{{ component.eyebrow }}</span>{% endif %}<h2 id="mood-title">{{ component.title_before|default('إيش') }} <em>{{ component.title_em|default('مودك') }}</em> {{ component.title_after|default('اليوم؟') }}</h2>{% if component.subtitle %}<p>{{ component.subtitle }}</p>{% endif %}</header>
{% set picked = component.products|default([]) %}{% set auto = picked|length == 0 %}{% set n = auto ? 7 : picked|length %}{% set angle = 360 / n %}{% set first = auto ? null : picked|first %}
<div class="orbit-stage" data-orbit-stage{% if auto %} data-auto-source="latest" data-auto-limit="7"{% endif %}><div class="orbit-wrap"><div class="orbit-track" role="list" aria-label="خيارات المود" data-orbit-track>
{% for round in [0, 1] %}{% for k in 0..(n - 1) %}{% set product = auto ? null : picked[k] %}<button type="button" class="orbit-node{% if k == 0 %} is-active{% endif %}" style="--orbit-index:{{ k }};--orbit-angle:{{ angle }}deg" aria-pressed="{{ k == 0 ? 'true' : 'false' }}"{% if round %} tabindex="-1" aria-hidden="true"{% endif %} data-mood-node="{{ k }}"{% if product %} aria-label="{{ product.name }}" data-id="{{ product.id }}" data-image="{{ product.image.url }}" data-name="{{ product.name }}" data-price="{{ product.price }}" data-url="{{ product.url }}"{% endif %} data-small="{{ labels[k % labels|length]|trim }}"><span aria-hidden="true">{{ icons[k % 7]|raw }}</span><b>{{ labels[k % labels|length]|trim }}</b></button>{% endfor %}{% endfor %}
</div></div>
<article class="orbit-focus"><a class="orbit-photo" href="{{ first ? first.url : '#' }}" data-mood-link><img src="{{ first ? first.image.url : '' }}" alt="{{ first ? first.name : '' }}" data-mood-photo></a><div class="orbit-copy"><small data-mood-small>{{ labels[0]|trim }}</small><h3 data-mood-name>{{ first ? first.name : '' }}</h3><strong data-mood-price>{% if first %}{{ first.price|money|raw }}{% endif %}</strong><div><button type="button" class="bg-primary text-primary-foreground shadow h-9 px-4 py-2 chocolate-add" data-add-to-cart="{{ first ? first.id : '' }}" data-url="{{ first ? first.url : '' }}" data-mood-add><svg aria-hidden="true" class="lucide lucide-shopping-bag" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M16 10a4 4 0 0 1-8 0"></path><path d="M3.103 6.034h17.794"></path><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"></path></svg> {{ component.cta_label|default('أبي هذا') }}</button></div></div></article></div>
<div class="orbit-controls" aria-label="التنقل بين المودات"><button type="button" class="orbit-control" data-mood-prev aria-label="المود السابق">‹</button><button type="button" class="orbit-control orbit-surprise" data-mood-surprise>{{ trans('chocolate.surprise') }}</button><button type="button" class="orbit-control" data-mood-next aria-label="المود التالي">›</button></div>

</section>
