{% set product=component.product|first %}{% if product %}<section class="chocolate-section spotlight-product" data-testid="store-home-spotlight">{% if component.media %}<img src="{{ component.media }}" alt="{{ product.name }}">{% endif %}<h2 class="chocolate-title">{{ component.title }}</h2><h3>{{ product.name }}</h3><strong>{{ product.price|money }}</strong><p>{{ component.copy }}</p><a href="{{ product.url }}">شوف المنتج</a></section>{% endif %}