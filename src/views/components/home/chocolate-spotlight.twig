{% set product = component.product|first %}
<section class="spotlight"><div class="spotlight-image">{% if component.media %}<img src="{{ component.media }}" alt="{{ product ? product.name : component.title }}" loading="lazy">{% elseif product %}<img src="{{ product.image.url }}" alt="{{ product.name }}" loading="lazy">{% endif %}</div><div class="spotlight-copy">{% if component.eyebrow %}<span>{{ component.eyebrow }}</span>{% endif %}<h2>{{ component.title }}{% if component.title_em %} <em>{{ component.title_em }}</em>{% endif %}</h2>{% if component.copy %}<p>{{ component.copy }}</p>{% endif %}<a class="button-link" href="{{ product ? product.url : link('products') }}">{{ component.cta_label|default('شوف المنتج') }} <svg aria-hidden="true" class="lucide lucide-arrow-left" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg></a></div></section>
