<section class="curated"><div class="section-heading split"><div>{% if component.eyebrow %}<span>{{ component.eyebrow }}</span>{% endif %}<h2>{{ component.title }}{% if component.title_em %} <em>{{ component.title_em }}</em>{% endif %}</h2></div><a class="text-link" href="{{ component.cta_url|default(link('products')) }}">{{ component.cta_label|default('كل المنتجات') }} <svg aria-hidden="true" class="lucide lucide-arrow-left" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg></a></div>
{% if component.products|length %}<div class="product-grid">{% for product in component.products %}<article class="group product-card product-card-{{ loop.index0 % 4 }}"><a class="product-media" href="{{ product.url }}"><img src="{{ product.image.url }}" alt="{{ product.name }}" loading="lazy">{% if product.subtitle %}<span>{{ product.subtitle }}</span>{% endif %}<svg aria-hidden="true" class="lucide lucide-arrow-up-left" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M7 17V7h10"></path><path d="M17 17 7 7"></path></svg></a><div class="product-info"><div><h3><a href="{{ product.url }}">{{ product.name }}</a></h3></div><strong>{{ (product.price|money|striptags|replace({'class=sicon-sar>':'','sicon-sar':'','</i>':'','<i':'','&lt;':'','&gt;':''})|trim) }} <span class="zn-sar" aria-hidden="true"></span></strong></div><button type="button" class="h-9 px-4 py-2 chocolate-add" data-add-to-cart="{{ product.id }}" data-url="{{ product.url }}"><svg aria-hidden="true" class="lucide lucide-plus" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> أضف للسلة</button></article>{% endfor %}</div>
{% else %}<div class="product-grid" data-zn-products data-source="latest" data-limit="4" aria-live="polite"></div>{% endif %}
</section>
