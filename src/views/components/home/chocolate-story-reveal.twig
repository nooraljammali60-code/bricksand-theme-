<section class="chocolate-section" data-testid="store-home-story-reveal">
  <div class="editorial-grid">
    {% if component.media_one %}<img src="{{ component.media_one }}" alt="{{ component.title }}" loading="lazy">{% endif %}
    <div class="editorial-copy">
      <h2 class="chocolate-title">{{ component.title }}</h2>
      {% if component.copy %}<p>{{ component.copy }}</p>{% endif %}
      {% if component.cta_url %}<div><a class="chocolate-btn" href="{{ component.cta_url }}">اكتشف</a></div>{% endif %}
    </div>
    {% if component.media_two %}<img src="{{ component.media_two }}" alt="" loading="lazy">{% endif %}
  </div>
</section>
