<footer class="chocolate-footer">{% if store.logo %}<img class="chocolate-footer__logo" src="{{ store.logo }}" alt="{{ store.name }}">{% else %}<h2>{{ store.name }}</h2>{% endif %}<salla-menu source="footer"></salla-menu><p>{{ store.description|default('') }}</p><nav class="footer-contact" aria-label="قنوات التواصل">{% if store.contacts.whatsapp %}<a href="https://wa.me/{{ store.contacts.whatsapp|replace({' ': '', '+': '', '-': ''}) }}" target="_blank" rel="noopener" aria-label="واتساب"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg></a>{% endif %}{% if store.social.instagram %}<a href="{{ store.social.instagram }}" target="_blank" rel="noopener" aria-label="إنستغرام"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg></a>{% endif %}{% if store.contacts.email %}<a href="mailto:{{ store.contacts.email }}" aria-label="البريد الإلكتروني"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></a>{% endif %}</nav><div class="footer-payments">{% component 'footer.payments' %}</div></footer>
