<header class="site-header" data-site-header>
<button type="button" class="h-9 w-9" data-overlay-open="menu" aria-label="فتح القائمة"><svg aria-hidden="true" class="lucide lucide-menu" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"></path></svg></button>
<a class="brand" href="{{ link('/') }}" aria-label="{{ store.name }}">{% set logo = theme.settings.get('logo_image')|default(store.logo) %}{% if logo %}<img src="{{ logo }}" alt="{{ store.name }}">{% else %}{{ store.name }}{% endif %}</a>
<div class="header-actions">
<button type="button" class="h-9 w-9" data-overlay-open="search" aria-label="بحث"><svg aria-hidden="true" class="lucide lucide-search" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg></button>
<a class="h-9 w-9 cart-trigger" href="{{ link('cart') }}" aria-label="سلة المشتريات"><svg aria-hidden="true" class="lucide lucide-shopping-bag" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M16 10a4 4 0 0 1-8 0"></path><path d="M3.103 6.034h17.794"></path><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"></path></svg><b data-cart-badge hidden>0</b></a>
</div>
</header>
<button type="button" class="category-tongue" data-overlay-open="menu" aria-label="فتح التصنيفات"><svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg><span>التصنيفات</span></button>
<div class="overlay-layer" data-overlay="menu" hidden><button type="button" class="overlay-backdrop" data-overlay-close aria-label="إغلاق"></button><section class="overlay-panel" role="dialog" aria-modal="true" aria-label="القائمة"><button type="button" class="overlay-close h-9 w-9" data-overlay-close aria-label="إغلاق"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
<div class="menu-panel"><div class="eyebrow">{{ store.name }}</div><p class="menu-display">الحلا<br><em>على مودك</em></p>
<nav><a href="{{ link('/') }}"><span>الرئيسية</span><svg aria-hidden="true" class="lucide lucide-arrow-up-left" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M7 17V7h10"></path><path d="M17 17 7 7"></path></svg></a><a href="{{ link('products') }}"><span>كل المنتجات</span><svg aria-hidden="true" class="lucide lucide-arrow-up-left" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M7 17V7h10"></path><path d="M17 17 7 7"></path></svg></a><div class="menu-categories" data-menu-categories><salla-menu source="main"></salla-menu></div>{% if theme.settings.get('story_url') %}<a href="{{ theme.settings.get('story_url') }}"><span>حكايتنا</span><svg aria-hidden="true" class="lucide lucide-arrow-up-left" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M7 17V7h10"></path><path d="M17 17 7 7"></path></svg></a>{% endif %}<a href="{{ link('cart') }}"><span>السلة</span><svg aria-hidden="true" class="lucide lucide-arrow-up-left" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M7 17V7h10"></path><path d="M17 17 7 7"></path></svg></a><a href="{{ link('customer/profile') }}"><span>حسابي</span><svg aria-hidden="true" class="lucide lucide-arrow-up-left" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M7 17V7h10"></path><path d="M17 17 7 7"></path></svg></a></nav>
{% if theme.settings.get('menu_image') %}<img src="{{ theme.settings.get('menu_image') }}" alt="{{ store.name }}">{% endif %}</div></section></div>
<div class="overlay-layer" data-overlay="search" hidden><button type="button" class="overlay-backdrop" data-overlay-close aria-label="إغلاق"></button><section class="overlay-panel" role="dialog" aria-modal="true" aria-label="بحث"><button type="button" class="overlay-close h-9 w-9" data-overlay-close aria-label="إغلاق"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
<form class="search-panel" action="{{ link('search') }}" method="get"><label for="chocolate-search">إيش تدور؟</label><input id="chocolate-search" name="q" type="search" placeholder="اكتب اسم الحلا" autocomplete="off"></form></section></div>
