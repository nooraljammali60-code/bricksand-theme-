<header class="chocolate-header">
  <button type="button" data-menu-open aria-label="القائمة">☰</button>
  <a class="chocolate-logo" href="{{ link('/') }}" aria-label="{{ store.name }}">{% if store.logo %}<img src="{{ store.logo }}" alt="{{ store.name }}">{% else %}<span>{{ store.name }}</span>{% endif %}</a>
  <div class="chocolate-header__actions">
    <salla-search inline oval height="36"></salla-search>
    <salla-user-menu avatar-only></salla-user-menu>
    <salla-cart-summary></salla-cart-summary>
  </div>
</header>
<div class="drawer-backdrop" data-menu-close></div>
<aside class="chocolate-drawer" data-menu aria-label="القائمة">
  <button type="button" data-menu-close aria-label="إغلاق">×</button>
  <h2>{{ store.name }}</h2>
  <salla-search inline oval height="40"></salla-search>
  <a href="{{ link('/') }}">الرئيسية</a>
  <a href="{{ link('products') }}">المنتجات</a>
  <salla-menu source="header"></salla-menu>
</aside>
