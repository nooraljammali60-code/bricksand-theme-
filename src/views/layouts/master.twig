<!doctype html><html lang="{{ user.language.code|default('ar') }}" dir="{{ user.language.dir|default('rtl') }}"><head>{% hook 'head:start' %}<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ page.title|default(store.name) }}</title><link rel="stylesheet" href="{{ 'app.css'|asset }}">{% hook head %}{% hook 'head:end' %}{% block styles %}{% endblock %}</head><body class="{% hook 'body:classes' %}">{% hook 'body:start' %}{% component 'header.header' %}<main id="main-content">{% block content %}{% endblock %}</main>{% component 'footer.footer' %}<salla-add-product-toast></salla-add-product-toast><script defer src="{{ 'app.js'|asset }}"></script>{% block scripts %}{% endblock %}{% hook 'body:end' %}</body></html>
