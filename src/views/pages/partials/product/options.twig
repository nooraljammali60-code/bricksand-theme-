{% if product.options|length %}<div class="zn-product-options"><salla-product-options data-testid="store-product-options" options="{{ product.options }}" product-id="{{ product.id }}"></salla-product-options></div>{% endif %}{% if product.has_bundle_products %}<salla-multiple-bundle-product bundle-sections='{{ product|json_encode }}'></salla-multiple-bundle-product>{% endif %}{% if product.can_add_note or product.can_upload_file %}<section class="zn-product-attachments">{% if product.can_add_note %}<textarea class="form-input" placeholder="{{ trans('pages.products.notes_placeholder') }}" name="notes">{{ product.notes }}</textarea>{% endif %}{% if product.can_upload_file %}<salla-file-upload accept="image/png, image/jpeg, image/jpg, image/gif, video/*, application/pdf" class="product-option-uploader"></salla-file-upload>{% endif %}</section>{% endif %}