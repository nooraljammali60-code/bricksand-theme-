{% extends "layouts.master" %}
{% block content %}
<div class="s-blocks-wrapper s-information-page !mt-0">{% hook 'information_page.information_page' %}</div>
{% set page_title = page.title|striptags %}
{% set page_text = page.content|striptags|trim %}

{% if 'من نحن' in page_title or 'About' in page_title or 'about' in page_title %}
<main class="about-page zn-info-final-page">
  <header class="policy-hero about-page-hero">
    <div class="shell">
      <span class="eyebrow">{{ store.name }}</span>
      <h1>{{ trans('chocolate.about_title') }}</h1>
      <p>{{ trans('chocolate.about_intro') }}</p>
    </div>
  </header>

  <section class="about-section section about-page-section">
    <div class="shell about-grid">
      <div class="about-copy">
        <span class="eyebrow">{{ trans('chocolate.story') }}</span>
        <h2 class="title">{{ trans('chocolate.about_story_title') }}</h2>
        <p class="about-lead">{{ trans('chocolate.about_story_lead') }}</p>
        <p>{{ trans('chocolate.info_about_philosophy') }}</p>

        <div class="about-points">
          <div><span>01</span><b>{{ trans('chocolate.point1') }}</b><small>{{ trans('chocolate.info_point1_desc') }}</small></div>
          <div><span>02</span><b>{{ trans('chocolate.point2') }}</b><small>{{ trans('chocolate.point2_desc') }}</small></div>
          <div><span>03</span><b>{{ trans('chocolate.point3') }}</b><small>{{ trans('chocolate.info_point3_desc') }}</small></div>
        </div>

        <div class="about-actions">
          <a class="btn btn-dark" href="{{ store.url }}/-/c1279180479">{{ trans('chocolate.shop_collection') }}</a>
          <a class="about-blog-link" href="{{ store.url }}/المدونة/page-60646618">{{ trans('chocolate.blog') }} <span>←</span></a>
        </div>
      </div>

      <div class="about-visual">
        <img src="{{ 'images/about.webp'|asset }}" alt="{{ store.name }}" loading="eager"/>
        <div class="about-visual-card">
          <img src="{{ 'images/brand-wordmark.webp'|asset }}" alt="{{ store.name }}"/>
          <p>{{ trans('chocolate.about_visual') }}</p>
        </div>
      </div>
    </div>
  </section>

  {% if page_text and page_text != page_title and page_text != 'من نحن' %}
  <section class="zn-info-final-extra section">
    <div class="shell"><article class="content-entry zn-info-final-card">{{ page.content|raw }}</article></div>
  </section>
  {% endif %}
</main>

