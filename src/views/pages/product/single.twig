{% extends "layouts.master" %}{% block content %}<div class="product-breadcrumb shell"><a href="{{ store.url }}">{{ trans('common.elements.home')|default('الرئيسية') }}</a><span>›</span><a href="{{ link('products') }}">{{ trans('chocolate.products') }}</a><span>›</span><strong>{{ product.name }}</strong></div>
<div class="s-blocks-wrapper s-before-product-info !mt-0">{% hook 'product.single.before_product_info' %}</div>
<section class="product-detail-page shell" id="product-{{ product.id }}"><div class="product-gallery-page zn-product-gallery"><div class="product-main-media">{% if product.promotion_title %}<span class="product-media-tag">{{ product.promotion_title }}</span>{% endif %}<img id="znProductMainImage" src="{{ product.image.url }}" alt="{{ product.image.alt ?: product.name }}"/></div>{% if product.images|length > 1 %}<div class="product-thumbnails">{% for image in product.images %}{% if image.type == 'image' %}<button type="button" data-zn-thumb data-src="{{ image.url }}" data-alt="{{ image.alt }}" class="{{ loop.first ? 'is-active' : '' }}"><img src="{{ image.url }}" loading="{{ loop.index < 5 ? 'eager' : 'lazy' }}" alt="{{ image.alt }}"/></button>{% endif %}{% endfor %}</div>{% endif %}</div>
<div class="product-info-page">{% if product.category %}<p class="product-category">{{ product.category.name }}</p>{% endif %}<h1>{{ product.name }}</h1><div class="product-price-line">{% if product.is_on_sale %}<strong>{{ product.sale_price|money }}</strong><del>{{ product.regular_price|money }}</del>{% else %}<strong>{{ product.starting_price ? product.starting_price|money : product.price|money }}</strong>{% endif %}</div>{% if product.is_taxable %}<small class="color-grey">{{ trans('pages.products.tax_included') }}</small>{% endif %}<salla-social-share data-testid="store-product-social-share" class="zn-product-share" aria-label="social share"></salla-social-share>{% if product.subtitle %}<p class="product-description">{{ product.subtitle }}</p>{% endif %}{% if product.description %}<div class="product-description article--main">{{ product.description|replace({'&nbsp;':' '})|raw }}</div>{% endif %}
<salla-installment data-testid="store-product-installment" price="{{ product.price }}"></salla-installment>
{% if product.has_metadata %}<salla-metadata data-testid="store-product-metadata"></salla-metadata>{% endif %}
<div class="tailoring-note"><svg fill="none" height="22" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="22"><path d="M4 20 14.5 9.5M14 5l5 5M16.5 2.5l5 5-3 3-5-5 3-3ZM3 21l4.5-1.2L4.2 16.5 3 21Z"></path></svg><div><b>{{ trans('chocolate.tailored') }}</b><p>{{ trans('chocolate.tailored_text') }}</p></div></div>
<form data-testid="store-product-form" class="form product-form" enctype="multipart/form-data" method="post" onsubmit="return salla.form.onSubmit('cart.addItem', event)">
<input type="hidden" name="id" value="{{ product.id }}">
{% hook 'product:single.form.start' %}
{% include 'pages.partials.product.options' %}
{% hook 'product:single.form.end' %}
<div class="product-buy-row">
{% if product.is_hidden_quantity or product.type == 'booking' %}
<input type="hidden" value="1" name="quantity" aria-label="{{ trans('chocolate.quantity') }}"/>
{% else %}
<salla-quantity-input max="{{ product.max_quantity }}" value="1" name="quantity" aria-label="{{ trans('chocolate.quantity') }}"></salla-quantity-input>
{% endif %}
<salla-add-product-button data-testid="store-product-add-to-cart" {{ product.can_quick_buy ? 'quick-buy' : '' }} {{ product.is_require_shipping ? 'required-shipping' : '' }}
amount="{{ product.base_currency_price }}" product-status="{{ product.status }}" product-type="{{ product.type }}" product-id="{{ product.id }}" type="submit" width="wide"
{% if product.notify_availability %}{{ product.notify_availability.subscribed ? 'is-subscribed' : '' }} channels="{{ product.notify_availability.channels|join(',') }}" subscribed-options="{{ product.notify_availability.subscribed_options|json_encode }}" {{ product.notify_availability.options ? 'notify-options-availability' : '' }}{% endif %}>{{ product.add_to_cart_label }}</salla-add-product-button>
</div>
</form>
<salla-quick-order data-testid="store-product-quick-order" class="mt-5 md:-mb-2 block"></salla-quick-order>
<div class="product-accordions"><details open><summary>{{ trans('chocolate.product_details') }}</summary><div>{{ product.description|replace({'&nbsp;':' '})|raw }}</div></details><details><summary>{{ trans('chocolate.care') }}</summary><p>{{ trans('chocolate.care_text') }}</p></details><details><summary>{{ trans('chocolate.delivery') }}</summary><p>{{ trans('chocolate.delivery_text') }}</p></details><details><summary>{{ trans('chocolate.policy') }}</summary><p><a href="{{ theme.settings.get('zn_policy_url','#') }}">{{ trans('chocolate.policy') }}</a></p></details></div></div></section>
<div class="s-blocks-wrapper s-before-reviews">{% hook 'product.single.before_customer_reviews' %}</div>
{% if store.settings.rating.show_on_product %}<salla-comments item-id="{{ product.id }}" type="product"></salla-comments>{% endif %}<div class="s-blocks-wrapper s-before-related">{% hook 'product.single.before_product_recommendations' %}</div>
<section class="related-products-section shell"><span class="eyebrow">{{ trans('chocolate.related') }}</span><h2>{{ trans('chocolate.selected_for_you') }}</h2><salla-products-slider source="related" source-value="{{ product.id }}"></salla-products-slider></section>
<div class="s-blocks-wrapper s-after-related">{% hook 'product.single.after_product_recommendations' %}</div>{% endblock %}{% block scripts %}<script defer src="{{ 'product.js'|asset }}"></script>{% endblock %}