{% extends "layouts.master" %}
{% block content %}
{% if category and category.id %}{% set zn_src = 'categories' %}{% set zn_val = category.id %}
{% elseif brand and brand.id %}{% set zn_src = 'brands' %}{% set zn_val = brand.id %}
{% elseif tag and tag.id %}{% set zn_src = 'tags' %}{% set zn_val = tag.id %}
{% elseif page.slug == 'offers' %}{% set zn_src = 'offers' %}{% set zn_val = '' %}
{% else %}{% set zn_src = 'latest' %}{% set zn_val = '' %}{% endif %}
{# Same layout as the preview shop page: intro, pill row, staggered product grid filled with live Salla products. #}
<div class="page-shell zn-products-page">
  <header class="page-intro">
    <h1 id="page-main-title">{{ page.title|striptags }}</h1>
  </header>

  {% if category and category.sub_categories|length %}
    <nav class="filter-row" aria-label="التصنيفات الفرعية">
      <a class="active" href="{{ category.url }}" aria-current="page">الكل</a>
      {% for sub_category in category.sub_categories %}
        <a href="{{ sub_category.url }}">{{ sub_category.name }}</a>
      {% endfor %}
    </nav>
  {% endif %}

  <div class="s-blocks-wrapper s-before-products-list">{% hook 'product.index.before_products_group_with_filter' %}</div>

  <salla-filters filters="{{ filters|json_encode }}"></salla-filters>
  {% hook 'product:index.items.start' %}
  <div class="product-grid catalog-grid" data-zn-products data-source="{{ zn_src }}" data-source-value="{{ zn_val }}" data-limit="48" data-no-fallback aria-live="polite"></div>
  <div data-catalog-fallback hidden>
    <salla-products-list data-testid="store-products-list" source="{{ page.slug }}" source-value="{{ page.id }}"></salla-products-list>
  </div>
  {% hook 'product:index.items.end' %}

  <div class="s-blocks-wrapper s-after-products-list">{% hook 'product.index.after_products_group_with_filter' %}</div>
  {% hook 'product.index.after_testimonials' %}
</div>
{% endblock %}
