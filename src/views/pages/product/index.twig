{% extends "layouts.master" %}
{% block content %}
<main class="zn-products-page">
  <header class="zn-inner-hero">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="مسار التنقل"><salla-breadcrumb></salla-breadcrumb></nav>
      <span class="eyebrow">{{ trans('chocolate.collection_eyebrow') }}</span>
      <h1 id="page-main-title">{{ page.title|striptags }}</h1>

      {# Salla supplies each category's children. They are navigation filters below the main title. #}
      {% if category and category.sub_categories|length %}
        <nav class="zn-subcategory-filters" aria-label="التصنيفات الفرعية">
          {% for sub_category in category.sub_categories %}
            <a class="zn-subcategory-pill" href="{{ sub_category.url }}">{{ sub_category.name }}</a>
          {% endfor %}
        </nav>
      {% elseif not category %}
        {# Offers/search/listing pages: fill from the selected Salla Header Menu. #}
        <nav class="zn-subcategory-filters zn-main-category-filters" id="znMainCategoryFilters" aria-label="تصنيفات المتجر"></nav>
      {% endif %}
    </div>
  </header>

  <div class="s-blocks-wrapper s-before-products-list !mt-0">{% hook 'product.index.before_products_group_with_filter' %}</div>


  <section class="zn-products-section">
    <div class="shell">
      <div class="zn-products-layout {{ filters ? 'has-filters' : '' }}">
        {% if filters %}
          <aside class="zn-products-filter-panel">
            <button class="btn--close-sm close-filters sicon-cancel hidden" type="button" aria-label="إغلاق الفلاتر"></button>
            <salla-filters data-testid="store-products-filters" id="filters-menu"></salla-filters>
          </aside>
        {% endif %}

        <div class="zn-products-main">
          <div class="zn-products-toolbar">
            {% if filters %}
              <a data-testid="store-products-filters-mobile-trigger" href="#filters-menu" class="zn-mobile-filter-trigger lg:hidden" aria-label="فتح الفلاتر">
                <i class="sicon-filter"></i><span>{{ trans('chocolate.filters_label') }}</span>
              </a>
            {% endif %}

            {% if sort_options|length %}
              <label class="zn-sort-control" for="product-filter">
                <span>{{ trans('chocolate.sort_label') }}</span>
                <select id="product-filter">
                  {% for sort in sort_options %}
                    <option value="{{ sort.id }}" {{ sort.is_selected ? 'selected' : '' }}>{{ sort.name }}</option>
                  {% endfor %}
                </select>
              </label>
            {% endif %}
          </div>

          {% hook 'product:index.items.start' %}
          <salla-products-list data-testid="store-products-list" source="{{ page.slug }}" source-value="{{ page.id }}" {{ filters ? 'filters-results' : '' }}></salla-products-list>
          {% hook 'product:index.items.end' %}
        </div>
      </div>
    </div>
  </section>

  <div class="s-blocks-wrapper s-after-products-list">{% hook 'product.index.after_products_group_with_filter' %}</div>

  <div class="s-blocks-wrapper s-after-testimonials">{% hook 'product.index.after_testimonials' %}</div>
</main>
{% endblock %}

{% block scripts %}
  <script defer src="{{ 'product.js' | asset }}"></script>
{% endblock %}
